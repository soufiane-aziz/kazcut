# Kazcut SaaS Platform Environment Variables

# Site Production URL (Used for Canonical URLs, Open Graph, Sitemap & Robots.txt)
NEXT_PUBLIC_SITE_URL=https://kazcut.vercel.app

# Supabase Configuration (Free Tier Database)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Google AdSense (High-CPC Monetization)
# e.g., ca-pub-1234567890123456 (Leave blank in dev to see placeholder skeletons)
NEXT_PUBLIC_ADSENSE_PUBLISHER_ID=
